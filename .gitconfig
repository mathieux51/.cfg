[alias]
  tree = log --graph --all
  ignore = "!gi() { curl -L -s https://www.gitignore.io/api/$@ ;}; gi"
  f = "!git ls-files -m -o --exclude-standard | fzf --print0 -m | xargs -0 -t -o git add"
[format]
  pretty = "format:%C(red)%h%C(reset) - %s %C(blue)(%cr)%Creset %C(green)%an%C(reset) %C(yellow)%d%C(reset)"
[core]
  autocrlf = false
  safecrlf = true
  preloadindex = true
	excludesfile = /Users/mathieu/.gitignore_global
  editor = nvim
	pager = delta
[gc]
  auto = 256
[user]
  name = Mathieu
  email = mathieux51@gmail.com
[mergetool]
  prompt = false
	keepBackup = false
[merge]
  tool = vim_mergetool
  conflictstyle = diff3
[mergetool "vim_mergetool"]
  cmd = vim -f -c "MergetoolStart" "$MERGED" "$BASE" "$LOCAL" "$REMOTE"
  trustExitCode = true
[diff]
	tool = nvimdiff
[rerere]
	enabled = true
[push]
	default = current
[apply]
  whitespace = fix
[url "ssh://git@github.com/"]
  insteadOf = https://github.com/
[init]
  defaultBranch = main
[branch]
	autosetuprebase = always
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[difftool]
	prompt = false
[delta]
	side-by-side = true
	line-numbers = true
	navigate = true
	syntax-theme = Nord
	minus-style = "syntax \"#3b2c30\""
	minus-emph-style = "syntax \"#5e2f3a\""
	plus-style = "syntax \"#2c352c\""
	plus-emph-style = "syntax \"#385438\""
	line-numbers-minus-style = "\"#bf616a\""
	line-numbers-zero-style = "\"#4c566a\""
	line-numbers-plus-style = "\"#a3be8c\""
	file-style = "\"#88c0d0\" bold"
	hunk-header-style = "\"#81a1c1\""
	hunk-header-decoration-style = "\"#4c566a\""
